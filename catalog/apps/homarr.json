 "source": "https://github.com/homarr-labs/homarr",
 "main_port": 8102,
 "scheme": "http",
 "questions": [
  {
   "key": "APP_PORT",
   "label": "Web port",
   "type": "port",
   "hint": "The port on this server that opens the app.",
   "default": "8102",
   "required": true
  },
  {
   "key": "HOMARR_SECRET_ENCRYPTION_KEY",
   "label": "HOMARR_SECRET_ENCRYPTION_KEY",
   "type": "password",
   "min": 64,
   "generate": true
  }
 ],
 "compose": "services:\n  homarr-1:\n    container_name: homarr-1\n    image: ghcr.io/homarr-labs/homarr:v2.9.1\n    restart: unless-stopped\n    volumes:\n      - ${APP_DATA_DIR}/data:/appdata\n      - /var/run/docker.sock:/var/run/docker.sock\n    environment:\n      - TZ=${TZ}\n      - SECRET_ENCRYPTION_KEY=${HOMARR_SECRET_ENCRYPTION_KEY}\n    ports:\n      - ${APP_PORT}:7575\n"
}